generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  name           String?
  firstName      String?
  lastName       String?
  phone          String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  twoFactorEnabled Boolean @default(false)
  role           String    @default("USER")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  accounts       Account[]
  sessions       Session[]
  addresses      Address[]
  favorites      Favorite[]
  orders         Order[]
  stockMovementsCreated StockMovement[] @relation("StockMovementCreatedBy")
  inquiries       Inquiry[] @relation("InquiryCreatedBy")
  inquiriesResponded Inquiry[] @relation("InquiryRespondedBy")
  returnRequests ReturnRequest[] @relation("ReturnRequestCreatedBy")
  returnRequestsResponded ReturnRequest[] @relation("ReturnRequestRespondedBy")
  notifications  UserNotification[]
  sparePartReviews SparePartReview[]
  cartReminders CartReminder[]
  twoFactorToken TwoFactorToken?
  notificationPrefs Json?
}

model EmailVerification {
  id             String   @id @default(cuid())
  email          String   @unique
  codeHash       String
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  firstName      String
  lastName       String
  phone          String
  hashedPassword String
  address        Json?
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String   @unique
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model InquiryOtp {
  id        String   @id @default(cuid())
  email     String   @unique
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model TwoFactorToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String?
  fullName   String?
  phone      String?
  line1      String?
  line2      String?
  city       String?
  state      String?
  postalCode String?
  country    String?
  invoiceType AddressInvoiceType @default(INDIVIDUAL)
  companyName String?
  taxOffice   String?
  taxNumber   String?
  identityNumber String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingOrders Order[] @relation("OrderShippingAddress")
  billingOrders  Order[] @relation("OrderBillingAddress")

  @@index([userId])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum StockMovementReason {
  INITIAL
  PURCHASE
  ADJUSTMENT
  SALE
  RETURN
  DAMAGE
}

enum AddressInvoiceType {
  INDIVIDUAL
  COMPANY
}

model SparePartCategory {
  id        String      @id @default(cuid())
  name      String
  slug      String      @unique
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  spareParts SparePart[]
}

model SparePart {
  id           String   @id @default(cuid())
  sku          String?  @unique
  name         String
  description  String
  dimensions   String?
  hasSizeOptions Boolean @default(false)
  sizeOptions  String[] @default([])
  sizeOptionPrices Json @default("{}")
  sizeOptionImages Json @default("{}")
  priceCents   Int
  currency     String   @default("TRY")
  imageUrl     String?
  isFeatured   Boolean  @default(false)
  isActive     Boolean  @default(true)
  stockOnHand  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  categoryId String
  category   SparePartCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  images        SparePartImage[]
  stockMovements StockMovement[]
  favorites     Favorite[]
  orderItems    OrderItem[]
  reviews       SparePartReview[]

  @@index([categoryId])
  @@index([isFeatured])
  @@index([isActive])
}

model SparePartReview {
  id          String   @id @default(cuid())
  sparePartId String
  userId      String
  rating      Int
  title       String?
  body        String?
  isAnonymous Boolean  @default(false)
  isApproved  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sparePart SparePart @relation(fields: [sparePartId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sparePartId])
  @@index([sparePartId, createdAt])
  @@index([userId])
}

model SparePartImage {
  id          String   @id @default(cuid())
  sparePartId String
  url         String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  sparePart SparePart @relation(fields: [sparePartId], references: [id], onDelete: Cascade)

  @@index([sparePartId])
  @@index([sortOrder])
}

model Favorite {
  id          String   @id @default(cuid())
  userId      String
  sparePartId String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sparePart SparePart @relation(fields: [sparePartId], references: [id], onDelete: Cascade)

  @@unique([userId, sparePartId])
  @@index([userId])
  @@index([sparePartId])
}

model StockMovement {
  id          String              @id @default(cuid())
  sparePartId String
  delta       Int
  reason      StockMovementReason
  note        String?
  createdAt   DateTime            @default(now())

  createdByUserId String?
  createdByUser   User?               @relation("StockMovementCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  sparePart SparePart @relation(fields: [sparePartId], references: [id], onDelete: Cascade)

  @@index([sparePartId])
  @@index([createdByUserId])
  @@index([createdAt])
}

enum InquiryType {
  CONTACT
  QUOTE
}

enum InquiryStatus {
  NEW
  READ
  CLOSED
}

enum OrderStatus {
  PENDING
  PAID
  RECEIVED
  SHIPPED
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELED
}

enum OrderFulfillmentType {
  SHIPPING
  PICKUP
}

enum ReturnStatus {
  NEW
  UNDER_REVIEW
  APPROVED
  REJECTED
  REFUNDED
}

model Inquiry {
  id        String        @id @default(cuid())
  type      InquiryType
  status    InquiryStatus @default(NEW)

  name      String
  email     String
  phone     String?
  company   String?
  subject   String?
  product   String?
  message   String

  userId    String?
  user      User?         @relation("InquiryCreatedBy", fields: [userId], references: [id], onDelete: SetNull)

  adminResponse       String?
  respondedAt         DateTime?
  respondedByUserId   String?
  respondedByUser     User?     @relation("InquiryRespondedBy", fields: [respondedByUserId], references: [id], onDelete: SetNull)

  userSeenAt DateTime?

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@index([respondedByUserId])
}

model Order {
  id            String      @id @default(cuid())
  userId        String
  status        OrderStatus @default(PENDING)
  fulfillmentType OrderFulfillmentType @default(SHIPPING)
  totalCents    Int
  currency      String      @default("TRY")
  paymentSessionId      String? @unique @map("stripeSessionId")
  paymentIntentId       String? @unique @map("stripePaymentIntentId")
  shippingAddressId     String?
  billingAddressId      String?
  shippingCarrier       String?
  trackingNumber        String?
  trackingUrl           String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingAddress Address? @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  billingAddress  Address? @relation("OrderBillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  items OrderItem[]
  invoice Invoice?
  notifications UserNotification[]

  @@index([userId])
  @@index([createdAt])
  @@index([shippingAddressId])
  @@index([billingAddressId])
}

enum InvoiceProvider {
  MIKRO_EPORTAL
}

enum InvoiceStatus {
  PENDING
  PROCESSING
  ISSUED
  FAILED
}

model Invoice {
  id            String @id @default(cuid())
  orderId        String @unique
  provider       InvoiceProvider @default(MIKRO_EPORTAL)
  status         InvoiceStatus @default(PENDING)
  snapshot       Json?
  attemptCount   Int @default(0)
  lastAttemptAt  DateTime?
  nextAttemptAt  DateTime?
  lockedAt       DateTime?
  lockedBy       String?
  errorMessage   String?
  issuedAt       DateTime?
  invoiceNumber  String?
  ettn           String?
  pdfObjectPath  String?
  xmlObjectPath  String?
  providerPayload Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([nextAttemptAt])
}

model CartReminder {
  id         String   @id @default(cuid())
  userId     String?
  email      String   @unique
  items      Json
  totalCents Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  sentAt     DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([sentAt])
}

model ReturnRequest {
  id          String       @id @default(cuid())
  userId      String?
  status      ReturnStatus @default(NEW)
  name        String
  email       String
  phone       String?
  orderId     String
  itemName    String?
  reason      String
  resolution  String
  evidenceUrls String[]

  adminNote        String?
  respondedAt      DateTime?
  respondedByUserId String?
  respondedByUser   User?   @relation("ReturnRequestRespondedBy", fields: [respondedByUserId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User? @relation("ReturnRequestCreatedBy", fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@index([userId])
  @@index([respondedByUserId])
}

model UserNotification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String?
  message   String
  orderId   String?
  status    String?
  createdAt DateTime @default(now())
  seenAt    DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([seenAt])
}

model HomePanelConfig {
  id               String   @id
  capacitySchedule Json
  priceAlertSteps  Json
  procurementFlow  Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ExchangeRate {
  id            String   @id @default(cuid())
  baseCurrency  String
  quoteCurrency String
  rate          Float
  source        String
  effectiveDate String?
  fetchedAt     DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([baseCurrency, quoteCurrency])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  sparePartId String?
  name        String
  imageUrl    String?
  quantity    Int
  priceCents  Int
  createdAt   DateTime @default(now())

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sparePart SparePart? @relation(fields: [sparePartId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([sparePartId])
}
